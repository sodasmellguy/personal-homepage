<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.grzy.mapper.TbSeriesArticleMapper">

    <!-- 按专栏聚合文章数量（专栏列表批量取文章数，避免 N+1） -->
    <select id="selectCountGroupBySeries" resultType="java.util.Map">
        SELECT series_id AS seriesId, COUNT(*) AS cnt
        FROM tb_series_article
        GROUP BY series_id
    </select>

</mapper>
